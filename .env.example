# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SQLite database file path for persistent relational storage
DATABASE_PATH="./data/sellerhub.sqlite"

# Optional PostgreSQL connection string when migrating to external PostgreSQL in production
DATABASE_URL=""

# Session token signing & cookie secret
SESSION_SECRET="sellerhub-local-dev-secret-change-in-production"
