# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Runtime environment ('development' | 'production')
NODE_ENV="development"

# SQLite database file path for persistent relational storage
DATABASE_PATH="./data/shopino.sqlite"

# Session token HMAC secret & session duration (in hours)
SESSION_SECRET="change-this-to-a-64-char-random-hex-secret-in-production"
SESSION_TTL_HOURS="24"

# Demo login control:
# Set ALLOW_DEMO_LOGIN="false" in production to disable passwordless demo role switching.
ALLOW_DEMO_LOGIN="false"

# Optional comma-separated list of allowed CORS origins in production
CORS_ALLOWED_ORIGINS=""

# Optional initial owner bootstrap credentials (used only when seeding an empty database)
INITIAL_OWNER_EMAIL="admin@sellerhub.io"
INITIAL_OWNER_PASSWORD=""

